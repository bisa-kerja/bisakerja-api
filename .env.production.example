# Application
APP_NAME=bisakerja-api
APP_ENV=production
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
APP_URL=https://api-staging.example.com
FRONTEND_URL=https://app-staging.example.com

# Database
DATABASE_URL=postgresql://app_user:replace-with-password@ep-staging-breeze-a1b2c3d4-pooler.ap-southeast-1.aws.neon.tech/bisakerja_api?sslmode=require&channel_binding=require
DIRECT_DATABASE_URL=postgresql://app_user:replace-with-password@ep-staging-breeze-a1b2c3d4.ap-southeast-1.aws.neon.tech/bisakerja_api?sslmode=require&channel_binding=require
PRISMA_LOG_LEVEL=warn
SEED_USER_PASSWORD=Password123!
RUN_DATABASE_TESTS=false

# Security
CORS_ORIGINS=https://app-staging.example.com
TRUST_PROXY=true
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20

# Auth
AUTH_ACCESS_TOKEN_SECRET=your-prod-access-token-secret-32
AUTH_REFRESH_TOKEN_SECRET=your-prod-refresh-token-secret-32
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_TOKEN_TTL=15m
EMAIL_VERIFICATION_OTP_TTL=15m
AUTH_REFRESH_COOKIE_NAME=bisakerja_refresh
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_ISSUER=bisakerja-api
AUTH_AUDIENCE=bisakerja-frontend

# Email
EMAIL_PROVIDER=resend
EMAIL_FROM="Bisakerja <no-reply@staging.example.com>"
RESEND_API_KEY=replace-with-resend-key
RESEND_MAX_RETRIES=2

# Async Queue
REDIS_URL=redis://redis:6379
ASYNC_QUEUE_NAME=bisakerja-async
ASYNC_QUEUE_PREFIX=bisakerja
ASYNC_QUEUE_CONCURRENCY=10
ASYNC_QUEUE_MAX_ATTEMPTS=5
ASYNC_QUEUE_BACKOFF_MS=5000
ASYNC_QUEUE_RECOVERY_BATCH_SIZE=100
ASYNC_QUEUE_RECOVERY_INTERVAL_MS=5000

# Integrations
MODEL_API_BASE_URL=https://model-api-staging.example.com
MODEL_API_TIMEOUT_MS=10000
MODEL_API_SERVICE_TOKEN=your-prod-model-api-token
MODEL_API_ENABLE_MOCK=false
AI_CV_ANALYZER_GENAI_ENABLED=false
AI_CV_ANALYZER_GENAI_BASE_URL=https://openrouter.ai/api/v1
AI_CV_ANALYZER_GENAI_MODEL=openai/gpt-5.2
AI_CV_ANALYZER_GENAI_API_KEY=your-prod-ai-cv-analyzer-genai-api-key
AI_CV_ANALYZER_GENAI_TIMEOUT_MS=6000
AI_CV_ANALYZER_GENAI_MAX_RETRIES=0
SCRAPER_API_SERVICE_TOKEN=your-prod-scraper-api-token
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=your-prod-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-prod-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/auth/google/callback
JOB_STALE_AFTER_HOURS=72

# Uploads
FILE_STORAGE_DRIVER=local
UPLOAD_STORAGE_PATH=./storage/uploads
CV_UPLOAD_MAX_BYTES=5242880
CV_ALLOWED_MIME_TYPES=application/pdf
CV_RETENTION_DAYS=1

# Observability
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id
ENABLE_REQUEST_LOGGING=true
HEALTH_CHECK_TIMEOUT_MS=2000

# Compose-specific
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
