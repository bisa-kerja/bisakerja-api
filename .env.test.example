# Application
APP_NAME=bisakerja-api
APP_ENV=test
NODE_ENV=test
PORT=3001
API_PREFIX=/api/v1
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bisakerja_api_test
DIRECT_DATABASE_URL=
PRISMA_LOG_LEVEL=warn

# Security
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20

# Integrations
MODEL_API_BASE_URL=http://localhost:8000
MODEL_API_TIMEOUT_MS=10000
MODEL_API_SERVICE_TOKEN=test-model-service-token
MODEL_API_ENABLE_MOCK=true
SCRAPER_API_BASE_URL=http://localhost:8001
SCRAPER_API_SERVICE_TOKEN=test-scraper-service-token
JOB_SOURCE_PRIORITY=glints,jobstreet,kalibrr,dealls
JOB_STALE_AFTER_HOURS=72

# Uploads
FILE_STORAGE_DRIVER=local
UPLOAD_STORAGE_PATH=/tmp/bisakerja-api-test/uploads
CV_UPLOAD_MAX_BYTES=5242880
CV_ALLOWED_MIME_TYPES=application/pdf
CV_RETENTION_DAYS=1

# Email
EMAIL_PROVIDER=fake
EMAIL_FROM=no-reply@example.test

# Observability
LOG_LEVEL=silent
REQUEST_ID_HEADER=x-request-id
ENABLE_REQUEST_LOGGING=false
HEALTH_CHECK_TIMEOUT_MS=2000
