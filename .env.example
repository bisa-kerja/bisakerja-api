# Application
APP_NAME=bisakerja-api
APP_ENV=local
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://app_user:replace-with-password@ep-local-breeze-a1b2c3d4-pooler.ap-southeast-1.aws.neon.tech/bisakerja_api?sslmode=require&channel_binding=require
DIRECT_DATABASE_URL=postgresql://app_user:replace-with-password@ep-local-breeze-a1b2c3d4.ap-southeast-1.aws.neon.tech/bisakerja_api?sslmode=require&channel_binding=require
PRISMA_LOG_LEVEL=warn
SEED_USER_PASSWORD=Password123!
RUN_DATABASE_TESTS=false

# Security
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20

# Auth
AUTH_ACCESS_TOKEN_SECRET=your-local-access-token-secret-32
AUTH_REFRESH_TOKEN_SECRET=your-local-refresh-token-secret-32
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_TOKEN_TTL=30m
EMAIL_VERIFICATION_OTP_TTL=10m
AUTH_REFRESH_COOKIE_NAME=bisakerja_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_ISSUER=bisakerja-api
AUTH_AUDIENCE=bisakerja-frontend

# Email
EMAIL_PROVIDER=fake
EMAIL_FROM="Bisakerja <no-reply@example.test>"
RESEND_API_KEY=your-local-resend-api-key
RESEND_MAX_RETRIES=2

# Async Queue
REDIS_URL=redis://127.0.0.1:6379
ASYNC_QUEUE_NAME=bisakerja-async
ASYNC_QUEUE_PREFIX=bisakerja
ASYNC_QUEUE_CONCURRENCY=5
ASYNC_QUEUE_MAX_ATTEMPTS=4
ASYNC_QUEUE_BACKOFF_MS=5000
ASYNC_QUEUE_RECOVERY_BATCH_SIZE=50
ASYNC_QUEUE_RECOVERY_INTERVAL_MS=5000

# Integrations
MODEL_API_BASE_URL=http://localhost:8000
MODEL_API_TIMEOUT_MS=10000
MODEL_API_SERVICE_TOKEN=your-local-model-service-token
MODEL_API_ENABLE_MOCK=true
SCRAPER_API_SERVICE_TOKEN=your-local-scraper-service-token
JOB_STALE_AFTER_HOURS=72

# Uploads
FILE_STORAGE_DRIVER=local
UPLOAD_STORAGE_PATH=./storage/uploads
CV_UPLOAD_MAX_BYTES=5242880
CV_ALLOWED_MIME_TYPES=application/pdf
CV_RETENTION_DAYS=1

# Observability
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id
ENABLE_REQUEST_LOGGING=true
HEALTH_CHECK_TIMEOUT_MS=2000
