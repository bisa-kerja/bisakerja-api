# Application
APP_NAME=bisakerja-api
APP_ENV=local
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bisakerja_api
DIRECT_DATABASE_URL=
PRISMA_LOG_LEVEL=warn
RUN_DATABASE_TESTS=false

# Security
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20

# Auth
AUTH_ACCESS_TOKEN_SECRET=local-access-token-secret-change-me-32
AUTH_REFRESH_TOKEN_SECRET=local-refresh-token-secret-change-me-32
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_TOKEN_TTL=30m
EMAIL_VERIFICATION_OTP_TTL=10m
AUTH_REFRESH_COOKIE_NAME=bisakerja_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_ISSUER=bisakerja-api
AUTH_AUDIENCE=bisakerja-frontend

# Email
EMAIL_PROVIDER=fake
EMAIL_FROM=no-reply@example.test
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Observability
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id
ENABLE_REQUEST_LOGGING=true
HEALTH_CHECK_TIMEOUT_MS=2000
