{
  "name": "bisakerja-api",
  "version": "0.1.0",
  "description": "Backend API for Bisakerja.",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "main": "src/server.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "docker:compose:config": "docker compose -f docker-compose.yml config",
    "docker:compose:pull": "docker compose -f docker-compose.yml pull",
    "docker:compose:up": "docker compose -f docker-compose.yml up -d",
    "docker:compose:down": "docker compose -f docker-compose.yml down",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:routes": "bun test tests/integration/routes",
    "test:integration": "bun test tests/integration",
    "test:contracts": "bun test tests/integration/contracts",
    "test:smoke": "bun test tests/smoke",
    "docs:generate:openapi": "bun run src/scripts/generate-openapi.ts",
    "docs:generate:routes": "bun run src/scripts/generate-route-inventory.ts",
    "docs:generate:sync-readiness": "bun run src/scripts/generate-sync-readiness.ts",
    "docs:prepare:sync-bundle": "bun run src/scripts/prepare-docs-sync-bundle.ts",
    "docs:check": "bun run src/scripts/verify-docs.ts",
    "docs:scalar:check-config": "bunx @scalar/cli project check-config scalar.config.json",
    "docs:scalar:preview": "bunx @scalar/cli project preview scalar.config.json",
    "cleanup:cv-uploads": "bun run src/scripts/cleanup-expired-cv-files.ts",
    "prisma:generate": "bun node_modules/prisma/build/index.js generate",
    "prisma:migrate:dev": "bun node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "bun node_modules/prisma/build/index.js migrate deploy",
    "prisma:seed": "bun run prisma/seed.ts",
    "prisma:validate": "bun node_modules/prisma/build/index.js validate",
    "prisma:verify:migrations": "bun run prisma/verify-migrations.ts",
    "prisma:reset": "bun node_modules/prisma/build/index.js migrate reset --force",
    "prisma:reset:seed": "bun node_modules/prisma/build/index.js migrate reset --force && bun run prisma:seed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bisa-kerja/bisakerja-api.git"
  },
  "keywords": [
    "bisakerja",
    "backend",
    "api"
  ],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/bisa-kerja/bisakerja-api/issues"
  },
  "homepage": "https://github.com/bisa-kerja/bisakerja-api#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/cookie-parser": "1.4.10",
    "@types/jsonwebtoken": "9.0.10",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.2.1",
    "express-rate-limit": "8.4.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.1.1",
    "pg": "^8.20.0",
    "pino": "10.3.1",
    "prisma": "^7.8.0",
    "resend": "^6.12.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "^2.0.0",
    "bun-types": "1.3.3",
    "eslint": "10.2.1",
    "node-mocks-http": "1.17.2",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0",
    "undici-types": "7.25.0"
  }
}
